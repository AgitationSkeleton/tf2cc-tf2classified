/**
 * tf2cc_oldclass: the old TF2 Classic class weapons' one stat TF2 Classified 5205 does not implement.
 *
 * Old TF2 Classic (2.0.0 beta 4) items used "spawn ammo override" (mod_spawn_ammo_override): the
 * beta 4 R.P.G. spawned with 10 rockets in reserve instead of a full 20 (ammo packs still fill it
 * to 20). 5205 has no such attribute class, so this plugin applies it: at each spawn, a weapon
 * listed with "spawn_ammo" in configs/tf2cc_tf2c/oldclass.cfg (generated by gen_schema.py) has its
 * reserve set to that value (never raised). Every other stat of these items is native
 * (see docs/tf2classified/DEPLOY.md, "Old TF2 Classic class weapons").
 *
 * Also (eleventh round):
 *  - (the Poacher's Pride zoom emulation is gone: since batch 16 the Poacher is on 5205's hunting
 *    revolver class, which zooms natively);
 *  - "projectile_<team>": the Rescue Ranger's bolt gets its team's model (every skin family that
 *    team's), so the bolt is team-coloured even where the client draws skin 0;
 *  - particle effects the server sends with the "error" system (index 0: a name 5205 does not
 *    ship, e.g. one of the Rescue Ranger's ranged-pickup effects) are dropped instead of drawing
 *    a red X.
 */
#include <sourcemod>
#include <sdktools>
#include <tf2>

#pragma semicolon 1
#pragma newdecls required

#define CFG "configs/tf2cc_tf2c/oldclass.cfg"

public Plugin myinfo =
{
	name = "tf2cc old class weapons",
	author = "AgitationSkeleton",
	description = "Spawn reserve for old TF2 Classic class weapons on TF2 Classified",
	version = "1.0.0",
	url = ""
};

StringMap g_SpawnAmmo;   // defindex -> reserve at spawn
StringMap g_TeamProj;    // defindex -> "red|blue|green|yellow" projectile models

public void OnPluginStart()
{
	g_SpawnAmmo = new StringMap();
	g_TeamProj = new StringMap();
	LoadConfig();
	HookEvent("player_spawn", Event_Spawn);
	AddTempEntHook("TFParticleEffect", TE_Particle);
	RegAdminCmd("sm_tf2cc_oldclass_reload", Cmd_Reload, ADMFLAG_CONFIG, "Reload configs/tf2cc_tf2c/oldclass.cfg.");
	RegAdminCmd("sm_tf2cc_oldclass_apply", Cmd_Apply, ADMFLAG_CHEATS, "sm_tf2cc_oldclass_apply <target> - apply the spawn reserve now (testing).");
}

void LoadConfig()
{
	g_SpawnAmmo.Clear();
	g_TeamProj.Clear();
	char path[PLATFORM_MAX_PATH], def[12];
	BuildPath(Path_SM, path, sizeof(path), CFG);
	KeyValues kv = new KeyValues("tf2cc_tf2c_oldclass");
	if (!kv.ImportFromFile(path))
	{
		LogError("cannot read %s", path);
		delete kv;
		return;
	}
	if (kv.GotoFirstSubKey())
	{
		do
		{
			int ammo = kv.GetNum("spawn_ammo", -1);
			kv.GetString("defindex", def, sizeof(def));
			if (ammo >= 0 && def[0])
				g_SpawnAmmo.SetValue(def, ammo);
			char m[4][PLATFORM_MAX_PATH], all[4 * PLATFORM_MAX_PATH + 4];
			kv.GetString("projectile_red", m[0], sizeof(m[]));
			kv.GetString("projectile_blue", m[1], sizeof(m[]));
			kv.GetString("projectile_green", m[2], sizeof(m[]));
			kv.GetString("projectile_yellow", m[3], sizeof(m[]));
			if (m[0][0] && m[1][0] && m[2][0] && m[3][0] && def[0])
			{
				FormatEx(all, sizeof(all), "%s|%s|%s|%s", m[0], m[1], m[2], m[3]);
				g_TeamProj.SetString(def, all);
			}
		}
		while (kv.GotoNextKey());
	}
	delete kv;
}

public Action Cmd_Reload(int client, int args)
{
	LoadConfig();
	ReplyToCommand(client, "[tf2cc_oldclass] %d spawn reserve rule(s)", g_SpawnAmmo.Size);
	return Plugin_Handled;
}

public Action Cmd_Apply(int client, int args)
{
	char pattern[64], tn[64];
	int targets[MAXPLAYERS], n;
	bool ml;
	GetCmdArg(1, pattern, sizeof(pattern));
	if ((n = ProcessTargetString(pattern, client, targets, MAXPLAYERS, COMMAND_FILTER_ALIVE, tn, sizeof(tn), ml)) <= 0)
	{
		ReplyToTargetError(client, n);
		return Plugin_Handled;
	}
	for (int i = 0; i < n; i++)
		Timer_Apply(null, GetClientUserId(targets[i]));
	ReplyToCommand(client, "[tf2cc_oldclass] applied to %d player(s)", n);
	return Plugin_Handled;
}

public void Event_Spawn(Event event, const char[] name, bool dontBroadcast)
{
	if (g_SpawnAmmo.Size)
		CreateTimer(0.1, Timer_Apply, event.GetInt("userid"), TIMER_FLAG_NO_MAPCHANGE);   // after the loadout
}

public Action Timer_Apply(Handle timer, int userid)
{
	int client = GetClientOfUserId(userid);
	if (client <= 0 || !IsPlayerAlive(client))
		return Plugin_Stop;
	char key[12];
	int max = GetEntPropArraySize(client, Prop_Send, "m_hMyWeapons");
	for (int i = 0; i < max; i++)
	{
		int w = GetEntPropEnt(client, Prop_Send, "m_hMyWeapons", i);
		if (w <= MaxClients || !HasEntProp(w, Prop_Send, "m_iItemDefinitionIndex"))
			continue;
		IntToString(GetEntProp(w, Prop_Send, "m_iItemDefinitionIndex"), key, sizeof(key));
		int ammo;
		if (!g_SpawnAmmo.GetValue(key, ammo))
			continue;
		int type = GetEntProp(w, Prop_Send, "m_iPrimaryAmmoType");
		if (type < 0)
			continue;
		if (GetEntProp(client, Prop_Send, "m_iAmmo", _, type) > ammo)
			SetEntProp(client, Prop_Send, "m_iAmmo", ammo, _, type);
	}
	return Plugin_Stop;
}

public void OnMapStart()
{
	StringMapSnapshot snap = g_TeamProj.Snapshot();
	char key[12], all[4 * PLATFORM_MAX_PATH + 4], m[4][PLATFORM_MAX_PATH];
	for (int i = 0; i < snap.Length; i++)
	{
		snap.GetKey(i, key, sizeof(key));
		g_TeamProj.GetString(key, all, sizeof(all));
		ExplodeString(all, "|", m, 4, PLATFORM_MAX_PATH);
		for (int t = 0; t < 4; t++)
			PrecacheModel(m[t], true);
	}
	delete snap;
}

/* ------------------------------------------------------------------ */
/* Team-coloured projectiles                                          */
/* ------------------------------------------------------------------ */

public void OnEntityCreated(int entity, const char[] classname)
{
	if (g_TeamProj != null && g_TeamProj.Size && StrEqual(classname, "tf_projectile_arrow"))
		RequestFrame(Frame_Projectile, EntIndexToEntRef(entity));
}

public void Frame_Projectile(int ref)
{
	int ent = EntRefToEntIndex(ref);
	if (ent <= MaxClients || !HasEntProp(ent, Prop_Send, "m_hLauncher"))
		return;
	int launcher = GetEntPropEnt(ent, Prop_Send, "m_hLauncher");
	if (launcher <= MaxClients || !HasEntProp(launcher, Prop_Send, "m_iItemDefinitionIndex"))
		return;
	char key[12], all[4 * PLATFORM_MAX_PATH + 4], m[4][PLATFORM_MAX_PATH];
	IntToString(GetEntProp(launcher, Prop_Send, "m_iItemDefinitionIndex"), key, sizeof(key));
	if (!g_TeamProj.GetString(key, all, sizeof(all)))
		return;
	int team = GetEntProp(ent, Prop_Send, "m_iTeamNum") - 2;
	if (team < 0 || team > 3)
		return;
	ExplodeString(all, "|", m, 4, PLATFORM_MAX_PATH);
	SetEntityModel(ent, m[team]);
	SetEntProp(ent, Prop_Send, "m_nSkin", team);
}

/* ------------------------------------------------------------------ */
/* Missing particle systems                                           */
/* ------------------------------------------------------------------ */

public Action TE_Particle(const char[] te_name, const int[] players, int numClients, float delay)
{
	return TE_ReadNum("m_iParticleSystemIndex") == 0 ? Plugin_Stop : Plugin_Continue;
}
